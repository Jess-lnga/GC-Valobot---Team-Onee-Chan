{
    // --- CMake configure args ---
    "cmake.configureArgs": [
        "-DPICO_SDK_PATH=C:/pico-sdk/2.2.0",
        "-DCMAKE_MAKE_PROGRAM=C:/Users/Jérôme ESSOLA ELANGA/.pico-sdk/ninja/v1.12.1/ninja.exe"
    ],

    // --- CMake Tools ---
    "cmake.generator": "Ninja",
    "cmake.ninjaPath": "C:/Users/Jérôme ESSOLA ELANGA/.pico-sdk/ninja/v1.12.1/ninja.exe",
    "cmake.cmakePath": "C:/Users/Jérôme ESSOLA ELANGA/.pico-sdk/cmake/v3.31.5/bin/cmake.exe",

    // Build hors workspace
    "cmake.buildDirectory": "C:/PicoBuild/${workspaceFolderBasename}",

    "cmake.configureOnOpen": true,
    "cmake.automaticReconfigure": true,
    "cmake.useCMakePresets": "never",

    // Environnement transmis à CMake
    "cmake.configureEnvironment": {
        "PICO_SDK_PATH": "C:/pico-sdk/2.2.0",
        "PICO_TOOLCHAIN_PATH": "C:/Users/Jérôme ESSOLA ELANGA/.pico-sdk/toolchain/14_2_Rel1"
    },

    // Optionnel mais utile : copie compile_commands.json dans le workspace
    // pour aider IntelliSense si le build externe pose souci.
    "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",

    // --- Extension Raspberry Pi Pico ---
    "raspberry-pi-pico.useCmakeTools": true,
    "raspberry-pi-pico.cmakeAutoConfigure": false,
    "raspberry-pi-pico.cmakePath": "C:/Users/Jérôme ESSOLA ELANGA/.pico-sdk/cmake/v3.31.5/bin/cmake.exe",
    "raspberry-pi-pico.ninjaPath": "C:/Users/Jérôme ESSOLA ELANGA/.pico-sdk/ninja/v1.12.1/ninja.exe",

    // --- IntelliSense C/C++ ---
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

    // IMPORTANT : on donne aussi explicitement compile_commands.json
    // pour éviter les faux positifs si le provider CMake décroche.
    "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",

    "C_Cpp.default.compilerPath": "C:/Users/Jérôme ESSOLA ELANGA/.pico-sdk/toolchain/14_2_Rel1/bin/arm-none-eabi-gcc.exe",
    "C_Cpp.default.intelliSenseMode": "gcc-arm",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "c++17"
}