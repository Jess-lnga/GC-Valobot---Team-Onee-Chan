.program ov7670_capture

.wrap_target
    ; --- Sync frame : attendre une impulsion VSYNC complète ---
    wait 1 gpio 15          ; VSYNC high
    wait 0 gpio 15          ; VSYNC low -> frame active

    ; TX FIFO: HEIGHT-1, puis WIDTH-1
    pull block
    mov y, osr              ; y = HEIGHT-1

    pull block              ; osr = WIDTH-1 (reste dans OSR)

line_loop:
    ; --- Sync ligne : attendre front HREF low->high ---
    wait 0 gpio 16
    wait 1 gpio 16

    mov x, osr              ; x = WIDTH-1

    ; se caler sur PCLK bas avant le 1er byte (évite un démarrage "au milieu")
    wait 0 gpio 14

pixel_loop:
    ; --- Byte HI ---
    wait 1 gpio 14
    nop [1]
    in pins, 8
    wait 0 gpio 14

    ; --- Byte LO (autopush après 16 bits) ---
    wait 1 gpio 14
    nop [1]
    in pins, 8
    wait 0 gpio 14

    jmp x-- pixel_loop

    ; fin de ligne
    wait 0 gpio 16
    jmp y-- line_loop
.wrap
